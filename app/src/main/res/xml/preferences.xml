<?xml version="1.0" encoding="utf-8"?>
<PreferenceScreen xmlns:app="http://schemas.android.com/apk/res-auto">

    <PreferenceCategory app:title="@string/pref_category_general">
        <ListPreference
            app:defaultValue="google"
            app:entries="@array/search_engine_names"
            app:entryValues="@array/search_engine_keys"
            app:key="search_engine"
            app:title="@string/pref_search_engine"
            app:useSimpleSummaryProvider="true" />
        <EditTextPreference
            app:key="home_page"
            app:title="@string/pref_home_page"
            app:dialogMessage="@string/pref_home_page_hint"
            app:useSimpleSummaryProvider="true" />
        <SwitchPreferenceCompat
            app:defaultValue="true"
            app:key="desktop_mode"
            app:summary="@string/pref_desktop_mode_summary"
            app:title="@string/pref_desktop_mode" />
        <SwitchPreferenceCompat
            app:defaultValue="true"
            app:key="restore_tabs"
            app:title="@string/pref_restore_tabs" />
    </PreferenceCategory>

    <PreferenceCategory app:title="@string/pref_category_privacy">
        <SwitchPreferenceCompat
            app:defaultValue="true"
            app:key="javascript"
            app:summary="@string/pref_javascript_summary"
            app:title="@string/pref_javascript" />
        <SwitchPreferenceCompat
            app:defaultValue="false"
            app:key="third_party_cookies"
            app:summary="@string/pref_third_party_cookies_summary"
            app:title="@string/pref_third_party_cookies" />
        <SwitchPreferenceCompat
            app:defaultValue="false"
            app:key="clear_on_exit"
            app:summary="@string/pref_clear_on_exit_summary"
            app:title="@string/pref_clear_on_exit" />
        <Preference
            app:key="clear_data"
            app:summary="@string/pref_clear_data_summary"
            app:title="@string/clear_data_title" />
    </PreferenceCategory>

    <PreferenceCategory app:title="@string/pref_category_about">
        <Preference
            app:key="about"
            app:selectable="false"
            app:title="@string/app_name" />
        <Preference
            app:key="data_separation"
            app:selectable="false"
            app:summary="@string/about_data_separation"
            app:title="@string/about_data_separation_title" />
    </PreferenceCategory>
</PreferenceScreen>
