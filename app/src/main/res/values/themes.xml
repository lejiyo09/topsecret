<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.IndependentBrowser" parent="Theme.Material3.DayNight.NoActionBar">
        <item name="colorPrimary">@color/brand</item>
        <item name="android:statusBarColor">@color/tab_bar</item>
        <item name="android:navigationBarColor">@color/toolbar</item>
        <item name="android:windowBackground">@color/toolbar</item>
    </style>

    <style name="ToolbarButton">
        <item name="android:layout_width">40dp</item>
        <item name="android:layout_height">40dp</item>
        <item name="android:background">?attr/selectableItemBackgroundBorderless</item>
        <item name="android:scaleType">center</item>
        <item name="tint">@color/icon</item>
        <item name="android:focusable">true</item>
    </style>
</resources>
